# Browser-visible Vite configuration. Every VITE_ value is public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_PUBLIC_APP_URL=http://localhost:5173

# Add only when Paystack test/live checkout is enabled.
VITE_PAYSTACK_PUBLIC_KEY=

# Optional VAST advertising configuration. Add one network at a time.
VITE_EXOCLICK_ZONE_ID=
VITE_EXOCLICK_VAST_URL=
VITE_TRAFFICJUNKY_VAST_URL=
VITE_AD_SFW_VAST_URL=
VITE_TRAFFICSTARS_VAST_URL=
VITE_CUSTOM_VAST_URL=

# Never put SUPABASE_SERVICE_ROLE_KEY, payment-provider secrets, or private
# credentials in this file under a VITE_ name.
