# Supabase credentials (requires SERVICE_ROLE key to bypass RLS and update videos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage configuration
# Bucket where transcoded HLS directories and posters are stored
STORAGE_BUCKET_NAME=videos

# Optional CDN delivery URL (Simplifyd zero-data proxy or BunnyCDN pull zone)
# If omitted, public Supabase Storage URL will be used
# CDN_BASE_URL=https://stream.pulse.video

# Worker identity & polling
WORKER_ID=oracle-arm-worker-01
POLL_INTERVAL_MS=5000
CONCURRENCY=1

# System paths (Ubuntu 22.04 defaults)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
TEMP_DIR=/tmp/pulse_worker
